		<ee:transform doc:name="Set correlationId and transactionId" doc:id="03526182-2ddb-41fe-acd4-ac39c2a5bfeb" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
{
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="transactionId" ><![CDATA[attributes.headers.'x-transaction-id' default uuid()]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Start Log" doc:id="9761df45-8b24-4010-8b7e-07e350da7034" message="#[attributes.uriParams.nationalid]"/>
	</flow>
</mule>
