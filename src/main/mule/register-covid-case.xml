		<db:insert doc:name="Insert Covid Case Master" doc:id="9d33f00b-ae63-4b01-9d29-c01bf098c6dd" config-ref="Database_Config">
			<db:sql ><![CDATA[INSERT INTO cvd_case_master
	(source,
	case_type,
	first_name,
	last_name,
	phone,
	email,
	date_of_birth,
	national_id,
	national_id_type,
	street_address,
	city,
	state,
	postal,
	country,
	create_date,
	update_date,
	create_by,
	update_by)
VALUES 
	(:source,
	:case_type,
	:first_name,
	:last_name,
	:phone,
	:email,
	To_date(:date_of_birth, 'YYYY-MM-DD'),
	:national_id,
	:national_id_type,
	:street_address,
	:city,
	:state,
	:postal,
	:country,
	To_date(:create_date, 'YYYY-MM-DD'),
	To_date(:update_date, 'YYYY-MM-DD'),
	:create_by,
	:update_by)]]></db:sql>
		</db:insert>
